{
  "name": "VDX7 Mk I GUI Asset Pack",
  "version": "1.2.0",
  "format": "PNG RGBA",
  "referenceCanvas": { "width": 1447, "height": 1087 },
  "implementationCanvas": { "width": 1440, "height": 1080 },
  "scales": {
    "1x": "assets/1x",
    "2x": "assets/2x",
    "retinaSuffix": "@2x"
  },
  "naming": "kebab-case; <component>-<size?>-<state>.png",
  "brandPolicy": "VDX7 original branding only; no Yamaha name or logo",
  "textPolicy": "Labels and runtime values are drawn by JUCE; raster controls are intentionally blank",
  "palette": {
    "surface950": "#05090B",
    "surface900": "#071014",
    "surface850": "#0B181B",
    "surface800": "#0F1C1E",
    "steel500": "#52707A",
    "textPrimary": "#E6EEF0",
    "textSecondary": "#91A5AC",
    "accentCyan": "#00E7E7",
    "lcdMint": "#40D0A0",
    "lcdInk": "#06352E",
    "vuGreen": "#10EF22",
    "vuYellow": "#FFB000",
    "vuRed": "#F3211B",
    "keyIvory": "#D7D3CB"
  },
  "assets": [
    { "family": "chrome", "pattern": "chrome/main-window.png", "size1x": [1440, 1080], "usage": "base chassis; preserve aspect ratio" },
    { "family": "panel", "pattern": "panel/panel-9slice.png", "size1x": [320, 240], "states": ["normal"], "nineSliceInsets1x": [18, 18, 18, 18] },
    { "family": "panel", "pattern": "panel/content-surface-tile.png", "size1x": [128, 128], "usage": "repeat or stretch inside panel bounds" },
    { "family": "footer", "pattern": "footer/footer-bar.png", "size1x": [1024, 36], "usage": "horizontal stretch; draw all text in JUCE" },
    { "family": "branding", "pattern": "branding/vdx7-wordmark.png", "size1x": [300, 72], "usage": "header wordmark; preserve aspect ratio" },
    { "family": "button", "pattern": "buttons/button-{state}.png", "size1x": [96, 40], "states": ["normal", "hover", "pressed", "active"] },
    { "family": "tab", "pattern": "tabs/tab-{state}.png", "size1x": [112, 36], "states": ["normal", "hover", "pressed", "active"] },
    { "family": "knob64", "pattern": "knobs/knob-64-{state}.png", "size1x": [64, 64], "states": ["normal", "hover", "pressed", "active"], "angleRangeDegrees": [-135, 135] },
    { "family": "knob80", "pattern": "knobs/knob-80-{state}.png", "size1x": [80, 80], "states": ["normal", "hover", "pressed", "active"], "angleRangeDegrees": [-135, 135] },
    { "family": "knobOverlay", "pattern": "knobs/knob-pointer.png", "size1x": [64, 64], "usage": "rotate around center using normalized value" },
    { "family": "knobOverlay", "pattern": "knobs/knob-value-arc.png", "size1x": [64, 64], "usage": "mask/clip or redraw dynamically to current value" },
    { "family": "fader", "pattern": "faders/fader-track.png", "size1x": [36, 220], "usage": "static vertical track" },
    { "family": "faderThumb", "pattern": "faders/fader-thumb-{state}.png", "size1x": [58, 28], "states": ["normal", "hover", "pressed", "active"] },
    { "family": "led", "pattern": "meter/led-{state}.png", "size1x": [14, 24], "states": ["off", "green", "yellow", "red"] },
    { "family": "vuRail", "pattern": "meter/vu-rail.png", "size1x": [28, 220], "usage": "place LED segments inside rail" },
    { "family": "lcd", "pattern": "display/lcd-frame.png", "size1x": [600, 180], "nineSliceInsets1x": [26, 26, 26, 26], "usage": "blank screen; render text and diagrams dynamically" },
    { "family": "valueField", "pattern": "display/value-field.png", "size1x": [96, 32], "usage": "draw centered mono value text" },
    { "family": "graph", "pattern": "graph/envelope-grid.png", "size1x": [360, 140], "usage": "draw curve and points dynamically" },
    { "family": "wheel", "pattern": "wheels/wheel-base.png", "size1x": [48, 180], "usage": "shared pitch/mod base" },
    { "family": "wheelMarker", "pattern": "wheels/wheel-position-marker.png", "size1x": [32, 8], "color": "#00E7E7", "targets": ["pitch", "mod"], "pitchBehavior": "bipolar; center at rest; spring return", "modBehavior": "unipolar; minimum at bottom; maximum at top; no spring return", "usage": "translate vertically over the shared wheel base" },
    { "family": "whiteKey", "pattern": "keyboard/white-key-{state}.png", "size1x": [36, 132], "states": ["normal", "pressed"] },
    { "family": "blackKey", "pattern": "keyboard/black-key-{state}.png", "size1x": [24, 84], "states": ["normal", "pressed"] },
    { "family": "algorithmNode", "pattern": "algorithm/node-{state}.png", "size1x": [28, 24], "states": ["normal", "active"], "usage": "draw operator number in JUCE" },
    { "family": "icon", "pattern": "icons/chevron-{direction}.png", "size1x": [20, 20], "directions": ["left", "right"] },
    { "family": "divider", "pattern": "lines/section-divider.png", "size1x": [320, 2], "usage": "horizontal stretch" }
  ],
  "spritesheets": [
    { "path": "spritesheets/1x/buttons/button-states.png", "cellSize": [96, 40], "order": ["normal", "hover", "pressed", "active"] },
    { "path": "spritesheets/1x/tabs/tab-states.png", "cellSize": [112, 36], "order": ["normal", "hover", "pressed", "active"] },
    { "path": "spritesheets/1x/knobs/knob-64-states.png", "cellSize": [64, 64], "order": ["normal", "hover", "pressed", "active"] },
    { "path": "spritesheets/1x/meter/led-states.png", "cellSize": [14, 24], "order": ["off", "green", "yellow", "red"] }
  ]
}
